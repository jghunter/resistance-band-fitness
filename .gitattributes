# core.autocrlf is true in this clone, so a fresh checkout would rewrite these
# files with CRLF. Both are GENERATED by sync_phase_module.py from canonical
# modules that live outside this repo and are written with LF. The sync's
# --check mode byte-compares the generated copies against canonical, so a CRLF
# checkout would make it report drift that does not exist.
#
# Pin the generated files to LF so the comparison stays meaningful.
src/reports.js text eol=lf
src/phase1.js  text eol=lf
