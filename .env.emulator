# Loaded by Vite ONLY when it runs with `--mode emulator`, which is what
# `npm run dev:emulator` does. An ordinary `npm run dev` never sees this file
# and talks to the real Firebase project, unchanged.
#
# This holds no secret. It is a switch, and it is committed on purpose so the
# emulator works on any machine without a setup step.
#
# src/firebase.js ALSO requires import.meta.env.DEV, so a production build
# cannot connect to the emulator even if this variable reaches it.
VITE_USE_EMULATOR=true
